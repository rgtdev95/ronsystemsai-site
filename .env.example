# The one settings file. Copy to `.env` in the project folder, and the same file to the server
# (~/ronsystemsai/docker/.env). Never commit the real one: .env is in .gitignore.
#
# Keep comments on their own lines. Docker Compose and Python read "KEY=   # note" differently.
#
# Don't put APP_ENV or SITE_URL here. Where the site runs decides them:
#   your PC (uv run flask ...)  -> development, http://127.0.0.1:5000
#   the server (docker/compose.yml) -> production, https://ronsystemsai.com

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

CONTACT_EMAIL=contactme@ronsystemsai.com

# Proton Calendar booking page, in quotes because of the #. Empty = /book/ offers email only.
BOOKING_URL="https://calendar.proton.me/bookings#..."

# Full profile URLs. Empty = greyed-out icon in the footer.
# LinkedIn and Facebook also appear on /book/ as "Message me on ..."
SOCIAL_LINKEDIN=
SOCIAL_YOUTUBE=
SOCIAL_FACEBOOK=
SOCIAL_GITHUB=

# Umami analytics. Only switched on for the live site, so it's safe to leave these set everywhere.
UMAMI_SCRIPT_URL=https://stats.ronsystemsai.com/script.js
UMAMI_WEBSITE_ID=

# IndexNow (Bing and others): lets deploys ask search engines to recrawl right away. Optional.
# Generate with: python -c "import secrets; print(secrets.token_hex(16))"
# The site then serves it at https://ronsystemsai.com/<key>.txt, which IndexNow checks.
INDEXNOW_KEY=

# Server only: Umami's own database. Not used on your PC; fill in on the server's copy.
# Generate each with: python -c "import secrets; print(secrets.token_hex(32))"
# Once Umami is running, keep these values, or it loses access to its database.
UMAMI_DB_PASSWORD=
UMAMI_APP_SECRET=

# Server only: the release the server runs. docker/deploy.sh sets it; no need to edit it.
IMAGE_TAG=
